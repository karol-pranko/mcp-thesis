# Przypięte wersje usług rundy pomiarowej. Jedyne źródło dla scripts/setup_runpod.sh i testbed/docker-compose.yml.
# Wartości są zapisywane w raw_results/manifest.json (pinned_service_versions); wersje faktycznie
# działające są zapisywane w raw_results/environment.json.
PG_MAJOR=16
PG_MINOR=16.4
PGVECTOR_VERSION=0.7.4
KAFKA_VERSION=3.7.0
KAFKA_SCALA=2.13
OLLAMA_VERSION=0.35.0
PYTHON_VERSION=3.12
LLM_MODEL_SMALL=qwen2.5-coder:3b
LLM_MODEL_LARGE=qwen2.5-coder:7b
# Docker (tylko gdy pod ma Dockera): obrazy z przypiętymi tagami
DOCKER_PGVECTOR_IMAGE=pgvector/pgvector:0.7.4-pg16
DOCKER_KAFKA_IMAGE=apache/kafka:3.7.0
